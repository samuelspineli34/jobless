# Copie para .env (cp .env.example .env). O .env é ignorado pelo git.

# --- Banco ---------------------------------------------------------------
# Padrão: SQLite em data/jobs.db (zero configuração).
# PostgreSQL: suba com `docker compose up -d db` e descomente:
# DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs

# --- Agendamento ---------------------------------------------------------
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_HOURS=6

# --- Automação de candidaturas ------------------------------------------
# Piloto automático, envio automático e limite diário são controlados no Painel (ficam salvos no banco).
# Este valor é só o limite diário INICIAL.
DAILY_APPLICATION_LIMIT=20
# false = no modo assistido você VÊ o navegador e revisa antes de enviar (recomendado)
HEADLESS=false
# Quanto tempo o navegador fica aberto esperando sua revisão (modo assistido)
REVIEW_WAIT_MINUTES=20
# Gera currículo sob medida automaticamente para vagas acima da nota mínima
AUTO_GENERATE_RESUMES=true

# --- Coleta --------------------------------------------------------------
# Pausa (segundos) entre requisições — seja educado com os sites
HTTP_DELAY_SECONDS=2

# --- Tradução opcional de currículos (API da Anthropic) -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
